---
// Skeleton for the /frequency/ tool pages — Hum redesign chrome (2026-07): new
// Header/Footer around the untouched tool internals. The tool's own palette vars
// stay so its scoped styles render exactly as before.
import BaseHead from './BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import FrequencyCta from '../components/FrequencyCta.astro';

interface Props {
	title: string;
	description?: string;
	jsonLd?: object | object[];
}
const { title, description, jsonLd } = Astro.props;
---
<!DOCTYPE html>
<html lang="en-us">
<head>
	<BaseHead title={title} description={description} jsonLd={jsonLd} />
</head>
<body>
	<Header />
	<main class="freqMain">
		<slot />
		<FrequencyCta />
	</main>
	<Footer />
</body>
</html>
