---
// Content pages (SEO + legal) — Hum redesign chrome (2026-07). The markdown body
// keeps the .markdown-body class (styled in src/styles/_article.scss); the app CTA
// keeps the .pageCta classes shared with FrequencyCta. Markdown content untouched.
import BaseHead from './BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { app } from '../config';

interface Props {
  title: string;
  description?: string;
}
const { title, description } = Astro.props;
---
<!DOCTYPE html>
<html lang="en-us">
<head>
	<BaseHead title={title} description={description} />
</head>
<body>
	<Header />
	<main class="pageMain">
		<article class="page markdown-body">
			<slot />
			<div class="pageCta">
				<img class="pageCtaIcon" src={app.icon} alt="ShadowingKit app icon" width="64" height="64" />
				<div class="pageCtaText">
					<strong>ShadowingKit</strong>
					<span>Spanish speaking practice with the shadowing technique. First episodes free.</span>
				</div>
				<a class="appStoreLink" href={app.appStoreLink}><img class="pageCtaBadge" src="/assets/appstore.png" alt="Download on the App Store" /></a>
			</div>
		</article>
	</main>
	<Footer />
</body>
</html>
