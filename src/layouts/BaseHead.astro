---
// Exact port of _includes/head.html. The SEO-critical file — every tag must stay
// equivalent to the Jekyll output. Verified by scripts/verify-parity.mjs.
import { site as siteMeta, app, seoDefaults, flags } from '../config';
import Analytics from '../components/Analytics.astro';
import '../styles/main.scss';

interface Props {
  title?: string;
  description?: string;
  isHome?: boolean;
  // Extra page-specific JSON-LD (one object or several), emitted after the
  // sitewide SoftwareApplication block. Used by the frequency hub (Dataset).
  jsonLd?: object | object[];
}

const { title, description, isHome = false, jsonLd } = Astro.props;
const extraJsonLd = jsonLd ? (Array.isArray(jsonLd) ? jsonLd : [jsonLd]) : [];

const siteUrl = Astro.site!; // https://shadowingkit.com/
let pathname = Astro.url.pathname;
if (!pathname.endsWith('/')) pathname += '/';
const canonical = new URL(pathname, siteUrl).href;
const ogImage = new URL('/assets/og-image.png', siteUrl).href;
const homeUrl = new URL('/', siteUrl).href;

const pageTitle = title ?? siteMeta.pageTitle;
const metaDescription = description ?? app.description;
const ogTitle = title ?? seoDefaults.ogTitle;
const ogDescription = description ?? seoDefaults.ogDescription;
const twitterTitle = title ?? seoDefaults.twitterTitle;
const twitterDescription = description ?? seoDefaults.twitterDescription;
const ogType = isHome ? 'website' : 'article';

// JSON-LD: SoftwareApplication (all pages). Emitted via set:html so Astro does not
// treat the braces as expressions; the parity harness deep-equals the parsed object.
const softwareApplication = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: 'ShadowingKit - Spanish Practice',
  operatingSystem: 'iOS',
  applicationCategory: 'EducationApplication',
  offers: {
    '@type': 'Offer',
    price: '0',
    priceCurrency: 'USD',
    description: 'Free with premium subscription ($14.99/month or $99.99/year)',
  },
  description:
    'Spanish pronunciation practice app using the shadowing technique. 100+ native-speaker episodes with synchronized text highlighting.',
  url: homeUrl,
  downloadUrl: 'https://apps.apple.com/app/id6476920610',
};

// JSON-LD: FAQPage (homepage only, mirrors the visible FAQ section). Text kept exactly
// as the Jekyll head.html had it (it differs slightly from the visible FAQ wording).
const faqPage = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: [
    { '@type': 'Question', name: 'What is the shadowing technique?', acceptedAnswer: { '@type': 'Answer', text: 'Shadowing is a technique where you speak simultaneously with a native speaker, mimicking their rhythm, intonation, and pronunciation in real time. Originally developed for conference interpreter training, it builds speech automaticity, the ability to produce language without conscious translation.' } },
    { '@type': 'Question', name: 'How is shadowing different from just listening and repeating?', acceptedAnswer: { '@type': 'Answer', text: 'In standard listen-and-repeat, you stop the audio, think about what you heard, then say it, which keeps the analytical brain in control. In shadowing, you speak simultaneously with the audio, forcing your brain to bypass conscious translation and produce speech as a reflex. This is what builds real fluency.' } },
    { '@type': 'Question', name: 'How long until I see results from shadowing?', acceptedAnswer: { '@type': 'Answer', text: 'Research shows noticeable pronunciation gains within 4–6 weeks of consistent 10–15 minute daily sessions. Comprehension improvements appear even earlier, typically within 2–3 weeks.' } },
    { '@type': 'Question', name: 'How much time per day do I need for shadowing?', acceptedAnswer: { '@type': 'Answer', text: '10–15 minutes of focused shadowing per day is the research-backed sweet spot. Consistency matters far more than session length, daily short sessions outperform occasional long ones.' } },
    { '@type': 'Question', name: 'Do I need to understand the content to shadow it?', acceptedAnswer: { '@type': 'Answer', text: 'No, and that\'s part of what makes shadowing powerful. You train your phonological system even while processing meaning. That said, ShadowingKit\'s curated library is structured by proficiency level so you can start with content appropriate to your comprehension.' } },
    { '@type': 'Question', name: 'Is ShadowingKit good for complete beginners?', acceptedAnswer: { '@type': 'Answer', text: 'Yes. The app includes a dedicated A2 entry path called \'Spanish in Two Minutes\', 50+ short, slow-paced episodes designed to prevent cognitive overload for upper beginners. You need basic vocabulary, but you don\'t need to be intermediate to start.' } },
    { '@type': 'Question', name: 'What\'s the difference between the curated library and my own content?', acceptedAnswer: { '@type': 'Answer', text: 'The curated library is recorded by a native speaker at controlled pacing, structured by proficiency level, and covers topics designed to be engaging and culturally relevant. Your own content lets you shadow anything that interests you, a TikTok creator you follow, a podcast, a TV show, auto-transcribed and formatted the same way.' } },
    { '@type': 'Question', name: 'How does the auto-transcription work?', acceptedAnswer: { '@type': 'Answer', text: 'You import an audio or video file (or record audio directly in the app), and the app automatically generates a synchronized transcript using speech recognition. The result is the same highlighted-text shadowing experience as the curated content.' } },
    { '@type': 'Question', name: 'Is there a free trial?', acceptedAnswer: { '@type': 'Answer', text: 'Yes, in two ways. About 20% of the library is permanently free from the moment you sign up, no credit card required. If you decide to go premium, both plans include a 3-day free trial before you\'re charged.' } },
    { '@type': 'Question', name: 'What does the premium subscription include?', acceptedAnswer: { '@type': 'Answer', text: 'Full access to the entire curated library (100+ episodes), unlimited custom content imports, and all future content updates. $14.99/month or $99.99/year.' } },
    { '@type': 'Question', name: 'Does ShadowingKit work offline?', acceptedAnswer: { '@type': 'Answer', text: 'Curated episodes can be downloaded for offline use. Custom content you\'ve already imported is also available offline after the initial transcription.' } },
  ],
};
---
<meta charset="utf-8" />
<meta http-equiv="x-ua-compatible" content="ie=edge" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<base target="_blank" />

<title>{pageTitle}</title>
<meta name="description" content={metaDescription} />

<link rel="canonical" href={canonical} />
<link rel="shortcut icon" href={app.icon} />

<!-- Open Graph -->
<meta property="og:title" content={ogTitle} />
<meta property="og:description" content={ogDescription} />
<meta property="og:image" content={ogImage} />
<meta property="og:url" content={canonical} />
<meta property="og:type" content={ogType} />

<!-- Twitter Card -->
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={twitterTitle} />
<meta name="twitter:description" content={twitterDescription} />
<meta name="twitter:image" content={ogImage} />

<!-- JSON-LD: SoftwareApplication -->
<script type="application/ld+json" set:html={JSON.stringify(softwareApplication)} />

{isHome && (
  <script type="application/ld+json" set:html={JSON.stringify(faqPage)} />
)}

{/* JSON-LD: page-specific (e.g. Dataset on the frequency hub) */}
{extraJsonLd.map((obj) => (
  <script type="application/ld+json" set:html={JSON.stringify(obj)} />
))}

<!-- Smart App Banner -->
{flags.enableSmartAppBanner && (
  <meta name="apple-itunes-app" content={`app-id=${app.iosAppId}`} />
)}

<!-- Preconnect hints -->
<link rel="preconnect" href="https://use.fontawesome.com" />
<link rel="preconnect" href="https://www.googletagmanager.com" />

<link
  rel="stylesheet"
  href="https://use.fontawesome.com/releases/v5.6.3/css/all.css"
  integrity="sha384-UHRtZLI+pbxtHCWp1t77Bi1L4ZtiqrqD80Kn4Z8NTSRyMA2Fd33n5dQ8lWUE00s/"
  crossorigin="anonymous"
  media="print"
  onload="this.media='all'"
/>
<noscript>
  <link
    rel="stylesheet"
    href="https://use.fontawesome.com/releases/v5.6.3/css/all.css"
    integrity="sha384-UHRtZLI+pbxtHCWp1t77Bi1L4ZtiqrqD80Kn4Z8NTSRyMA2Fd33n5dQ8lWUE00s/"
    crossorigin="anonymous"
  />
</noscript>

<Analytics />
