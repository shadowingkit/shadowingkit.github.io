---
// Ft8 marquee footer (Hum redesign 2026-07). Shared site-wide. The meta row keeps
// the include_in_footer flag mechanism (today: Privacy Policy + Terms of Use) so
// no flagged page ever drops out of the site-wide footer links.
import { social, app } from '../config';
import { pagesWithFlag, pageUrl } from '../lib/pages';
const footerLinks = await pagesWithFlag('include_in_footer');
---
<footer class="foot-marquee" aria-label="Footer">
  <div class="foot-marquee__track" aria-hidden="true">
    <span>SHADOWINGKIT · SPEAK SPANISH OUT LOUD · SHADOWINGKIT · SPEAK SPANISH OUT LOUD ·</span>
    <span>SHADOWINGKIT · SPEAK SPANISH OUT LOUD · SHADOWINGKIT · SPEAK SPANISH OUT LOUD ·</span>
  </div>
  <p class="visually-hidden">ShadowingKit. Speak Spanish out loud.</p>
  <div class="foot-meta">
    {footerLinks.map((page) => (
      <a href={pageUrl(page)} target="_self">{page.data.title}</a>
    ))}
    <a href="/frequency/" target="_self">Free Word Tool</a>
    {social.emailAddress && <a href={`mailto:${social.emailAddress}`}>Contact</a>}
    {app.pressKitDownloadLink && <a href={app.pressKitDownloadLink}>Press Kit</a>}
    <span>© 2026 ShadowingKit</span>
  </div>
</footer>
