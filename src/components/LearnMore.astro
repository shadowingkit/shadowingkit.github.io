---
// Learn-more index: two-column link list of every page flagged include_in_learn_more
// (the homepage's internal-link surface to the 20-page SEO cluster — never trim it).
// (Hum redesign 2026-07.)
import { pagesWithFlag, pageUrl } from '../lib/pages';
const learnMorePages = await pagesWithFlag('include_in_learn_more');
---
<section class="section learn" aria-labelledby="learn-title">
  <h2 id="learn-title">Learn more about speaking Spanish</h2>
  <p class="learn__lede">Guides on the shadowing technique, production freeze, and how to build a speaking routine that works.</p>
  <div class="learn__grid">
    {learnMorePages.map((page) => (
      <a href={pageUrl(page)} target="_self">{page.data.title}</a>
    ))}
  </div>
</section>
