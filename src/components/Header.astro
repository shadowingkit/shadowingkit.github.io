---
// N5 floating pill nav (Hum redesign 2026-07). Shared by the homepage, content
// pages (Page.astro), and the frequency tool (FrequencyBase.astro). Section links
// use absolute /#anchor paths so they work off-homepage; every internal link
// carries target="_self" because BaseHead emits <base target="_blank">.
// Pages flagged include_in_header (none today) are appended to the link row.
import { app } from '../config';
import { pagesWithFlag, pageUrl } from '../lib/pages';
const navPages = await pagesWithFlag('include_in_header');
---
<nav class="nav-pill" aria-label="Primary">
  <a class="wordmark" href="/" target="_self"><img src={app.icon} alt="" width="22" height="22">{app.name}</a>
  <ul class="nav-pill__links">
    <li><a href="/#how" target="_self">Method</a></li>
    <li><a href="/#library" target="_self">Library</a></li>
    <li><a href="/#science" target="_self">Science</a></li>
    <li><a href="/#faq" target="_self">FAQ</a></li>
    {navPages.map((page) => (
      <li><a href={pageUrl(page)} target="_self">{page.data.title}</a></li>
    ))}
  </ul>
  <div class="nav-pill__right">
    <a class="nav-pill__tool" href="/frequency/" target="_self">Free word tool</a>
    <a class="btn btn--ink" href={app.appStoreLink}>Get the app</a>
  </div>
</nav>
