---
// Homepage — Hum redesign (2026-07), componentized from the approved preview.
// isHome drives the head (og:type website, FAQPage schema). body.home scopes the
// homepage section styles (src/styles/_home.scss) away from the frequency tool.
import BaseHead from '../layouts/BaseHead.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import Journey from '../components/Journey.astro';
import Bento from '../components/Bento.astro';
import Solution from '../components/Solution.astro';
import HowItWorks from '../components/HowItWorks.astro';
import Science from '../components/Science.astro';
import Faq from '../components/Faq.astro';
import LearnMore from '../components/LearnMore.astro';
import FrequencyPromo from '../components/FrequencyPromo.astro';
import FinalCta from '../components/FinalCta.astro';
import Footer from '../components/Footer.astro';
---
<!DOCTYPE html>
<html lang="en">

<head>
    <BaseHead isHome={true} />
</head>

<body class="home">
    <Header />
    <Hero />
    <main>
        <Journey />
        <Bento />
        <Solution />
        <HowItWorks />
        <Science />
        <Faq />
        <LearnMore />
        <FrequencyPromo />
        <FinalCta />
    </main>
    <Footer />

    <script is:inline>
    (function () {
      var reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;

      // Counter tick-up (Hum signature move 4). Reduced motion: final value instantly.
      var counters = document.querySelectorAll('[data-count]');
      if ('IntersectionObserver' in window && !reduce) {
        var io = new IntersectionObserver(function (entries) {
          entries.forEach(function (entry) {
            if (!entry.isIntersecting) return;
            io.unobserve(entry.target);
            var el = entry.target;
            var target = parseInt(el.dataset.count, 10);
            var suffix = el.dataset.suffix || '';
            var t0 = null;
            var DUR = 1200;
            function frame(t) {
              if (t0 === null) t0 = t;
              var p = Math.min((t - t0) / DUR, 1);
              var eased = 1 - Math.pow(1 - p, 4);
              el.textContent = Math.round(eased * target) + suffix;
              if (p < 1) requestAnimationFrame(frame);
            }
            requestAnimationFrame(frame);
          });
        }, { threshold: 0.5 });
        counters.forEach(function (el) { io.observe(el); });
      }

      // Star-burst on primary CTA press (Hum signature move 7). One shot per click.
      if (!reduce) {
        document.querySelectorAll('.btn').forEach(function (btn) {
          btn.addEventListener('click', function (e) {
            var star = document.createElement('span');
            star.className = 'star-burst';
            star.setAttribute('aria-hidden', 'true');
            var r = btn.getBoundingClientRect();
            star.style.left = (e.clientX - r.left - 12) + 'px';
            star.style.top = (e.clientY - r.top - 12) + 'px';
            btn.appendChild(star);
            setTimeout(function () { star.remove(); }, 450);
          });
        });
      }
    })();
    </script>
</body>
</html>
